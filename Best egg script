local function CriarCaixinhaEgg(modeloOriginal)
    local Caixa = Instance.new("Frame")
    local UICornerCaixa = Instance.new("UICorner")
    local UIStrokeCaixa = Instance.new("UIStroke")
    local Viewport = Instance.new("ViewportFrame")
    local UICornerView = Instance.new("UICorner")
    local UIStrokeView = Instance.new("UIStroke")
    local StealButton = Instance.new("TextButton")
    local UICornerSteal = Instance.new("UICorner")
    local UIStrokeSteal = Instance.new("UIStroke")
    
    Caixa.Name = modeloOriginal.Name
    Caixa.Parent = Container
    Caixa.Size = UDim2.new(1, 0, 0, 55) 
    Caixa.BackgroundColor3 = Color3.fromRGB(45, 10, 110) 
    Caixa.BackgroundTransparency = 0.3 
    Caixa.BorderSizePixel = 0
    UICornerCaixa.CornerRadius = UDim.new(0, 5)
    UICornerCaixa.Parent = Caixa
    UIStrokeCaixa.Thickness = 1
    UIStrokeCaixa.Color = Color3.fromRGB(0, 0, 0)
    UIStrokeCaixa.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    UIStrokeCaixa.Parent = Caixa
    
    Viewport.Name = "Egg3DView"
    Viewport.Parent = Caixa
    Viewport.Position = UDim2.new(0, 6, 0, 6) 
    Viewport.Size = UDim2.new(0, 43, 0, 43) 
    Viewport.BackgroundColor3 = Color3.fromRGB(0, 0, 0) 
    Viewport.BackgroundTransparency = 0.1 
    Viewport.BorderSizePixel = 0
    UICornerView.CornerRadius = UDim.new(0, 4) 
    UICornerView.Parent = Viewport
    UIStrokeView.Thickness = 1
    UIStrokeView.Color = Color3.fromRGB(20, 20, 20) 
    UIStrokeView.Parent = Viewport
    
    local CloneModelo = modeloOriginal:Clone()
    CloneModelo.Parent = Viewport
    local CameraVirtual = Instance.new("Camera")
    Viewport.CurrentCamera = CameraVirtual
    CameraVirtual.Parent = Viewport
    
    local primPart = CloneModelo:IsA("Model") and (CloneModelo.PrimaryPart or CloneModelo:FindFirstChildWhichIsA("BasePart")) or CloneModelo
    if primPart and primPart:IsA("BasePart") then
        CameraVirtual.CFrame = CFrame.new(primPart.Position + Vector3.new(0, 0, 4), primPart.Position)
    end
    
    StealButton.Name = "StealButton"
    StealButton.Parent = Caixa
    StealButton.Position = UDim2.new(0, 55, 0, 6)
    StealButton.Size = UDim2.new(1, -61, 0, 43) 
    StealButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50) 
    StealButton.Text = "Steal"
    StealButton.TextColor3 = Color3.fromRGB(255, 255, 255) 
    StealButton.TextSize = 15
    StealButton.Font = Enum.Font.SourceSansBold
    UICornerSteal.CornerRadius = UDim.new(0, 4)
    UICornerSteal.Parent = StealButton
    UIStrokeSteal.Thickness = 1
    UIStrokeSteal.Color = Color3.fromRGB(0, 0, 0)
    UIStrokeSteal.Parent = StealButton
    
    local isOn = false
    StealButton.Activated:Connect(function()
        ClickSound:Play()
        isOn = not isOn
        if isOn then
            StealButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) 
            task.spawn(function() IniciarMecanicaSteal(modeloOriginal) end)
        else
            StealButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50) 
            _G.ActiveSteals[modeloOriginal.Name] = false
        end
    end)
end

local EggFolder = workspace:WaitForChild("AreaEggSlotsClient", 10)
task.spawn(function()
    while task.wait(2) do
        if not EggFolder then continue end
        for _, item in pairs(EggFolder:GetChildren()) do
            if not TemParticula(item) then
                item:Destroy()
            else
                if not Container:FindFirstChild(item.Name) then CriarCaixinhaEgg(item) end
            end
        end
        for _, caixinha in pairs(Container:GetChildren()) do
            if caixinha:IsA("Frame") and not EggFolder:FindFirstChild(caixinha.Name) then
                caixinha:Destroy()
            end
        end
    end
end)

local panelOpen = false
local function AbrirPainel()
    panelOpen = true
    MainPanel.Visible = true
    MainPanel:TweenPosition(OpenedPosition, Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.4, true)
end

local function FecharPainel()
    panelOpen = false
    MainPanel:TweenPosition(ClosedPosition, Enum.EasingDirection.In, Enum.EasingStyle.Quart, 0.3, true, function()
        if not panelOpen then MainPanel.Visible = false end
    end)
end

local UserInputService = game:GetService("UserInputService")
local function VerificarToqueNoBotao(inputPos)
    local absPos = ToggleButton.AbsolutePosition
    local absSize = ToggleButton.AbsoluteSize
    if inputPos.X >= absPos.X and inputPos.X <= (absPos.X + absSize.X) then
        if inputPos.Y >= absPos.Y and inputPos.Y <= (absPos.Y + absSize.Y) then return true end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if VerificarToqueNoBotao(input.Position) then
            ClickSound:Play()
            ToggleButton:TweenSize(UDim2.new(0, 40, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.05, true, function()
                ToggleButton:TweenSize(UDim2.new(0, 45, 0, 45), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.05, true)
            end)
            if not panelOpen then AbrirPainel() else FecharPainel() end
        end
    end
end)
                            
