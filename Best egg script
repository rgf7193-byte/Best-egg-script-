-- FILTRO PARA CHECAR PARTÍCULAS
local function TemParticula(modelo)
    for _, objeto in pairs(modelo:GetDescendants()) do
        if objeto:IsA("ParticleEmitter") or objeto:IsA("Trail") or objeto:IsA("Beam") then
            return true
        end
    end
    return false
end

_G.ActiveSteals = _G.ActiveSteals or {}

-- ==========================================================
-- FUNÇÃO DE CORRIDA ATÉ O OVO E DISPARO COMPLETO DO TRAJETO
-- ==========================================================
local function IniciarMecanicaSteal(modeloOvo)
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    
    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    local playerGui = player:WaitForChild("PlayerGui")
    
    local ovoID = modeloOvo.Name
    _G.ActiveSteals[ovoID] = true
    
    local alvoPart = modeloOvo:IsA("Model") and (modeloOvo.PrimaryPart or modeloOvo:FindFirstChildWhichIsA("BasePart")) or modeloOvo
    if not alvoPart then return end
    
    local attachment = rootPart:FindFirstChild("StealAttachment") or Instance.new("Attachment", rootPart)
    attachment.Name = "StealAttachment"
    
    local linearVelocity = rootPart:FindFirstChild("StealVelocity") or Instance.new("LinearVelocity", rootPart)
    linearVelocity.Name = "StealVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Enabled = true
    
    local conexaoCorrida
    conexaoCorrida = RunService.Heartbeat:Connect(function()
        if not _G.ActiveSteals[ovoID] then
            if linearVelocity and linearVelocity.Parent then linearVelocity:Destroy() end
            if attachment and attachment.Parent then attachment:Destroy() end
            if conexaoCorrida then conexaoCorrida:Disconnect() end
            return
        end
        
        if character and rootPart and alvoPart and alvoPart.Parent then
            local direcao = (alvoPart.Position - rootPart.Position)
            local distancia = direcao.Magnitude
            
            if distancia > 4 then
                linearVelocity.VectorVelocity = direcao.Unit * 300
            else
                linearVelocity.VectorVelocity = Vector3.zero
                conexaoCorrida:Disconnect()
                
                task.wait(0.20) -- Trava por 0.50s no alvo
                
                linearVelocity.Enabled = false
                linearVelocity:Destroy()
                attachment:Destroy()
                
                if not _G.ActiveSteals[ovoID] then return end
                                                                  -- EXECUÇÃO FIEL DAS ROTINAS DO SEU ARQUIVO ORIGINAL
                local coordenadaFinal = Vector3.new(535.6, 70.6, -364.3)
                local velocidadeCFrame = 100000 
                local originalName = humanoid.Name

                local function executarScriptBotao()
                    for _, objeto in ipairs(playerGui:GetDescendants()) do
                        if objeto.Name == "DropHeldEgg" then
                            local botao = objeto:FindFirstChild("Button")
                            if botao then
                                local conexoes = getconnections(botao.MouseButton1Click)
                                if #conexoes > 0 then
                                    for _, conexao in ipairs(conexoes) do conexao:Fire() end
                                else
                                    local conexoesAtivadas = getconnections(botao.Activated)
                                    for _, conexao in ipairs(conexoesAtivadas) do conexao:Fire() end
                                end
                                break
                            end
                        end
                    end
                end

                local function executarSistemaPrompts()
                    local function extrairPrompt(prompt)
                        if prompt:IsA("ProximityPrompt") then
                            prompt.HoldDuration = 0
                            task.spawn(function()
                                while prompt and prompt.Parent do
                                    if not _G.ActiveSteals[ovoID] then break end
                                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                                        local distance = (player.Character.HumanoidRootPart.Position - prompt.Parent:GetPivot().Position).Magnitude
                                        if distance <= prompt.MaxActivationDistance then fireproximityprompt(prompt) end
                                    end
                                    task.wait(0.1)
                                end
                            end)
                        end
                    end
                    for _, desc in pairs(workspace:GetDescendants()) do extrairPrompt(desc) end
                    workspace.DescendantAdded:Connect(extrairPrompt)
                end

                task.spawn(executarSistemaPrompts)

                -- GATILHO INTELIGENTE: Salva o seu Humanoid original em vez de destruir
                local humanoidOriginal = humanoid
                humanoidOriginal.Parent = nil -- Tira ele do personagem temporariamente para o jogo não bugar

                local fakeHumanoid = Instance.new("Humanoid")
                fakeHumanoid.Parent = character
                
                local posicionamentoTravadoCFrame = rootPart.CFrame
                local posicaoControleCFrame = rootPart.Position
                
                local loopTravaHeartbeat
                loopTravaHeartbeat = RunService.Heartbeat:Connect(function()
                    if not _G.ActiveSteals[ovoID] then
                        if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
                        return
                    end
                    if rootPart and rootPart.Parent then
                        rootPart.CFrame = posicionamentoTravadoCFrame
                        rootPart.Velocity = Vector3.zero
                        rootPart.RotVelocity = Vector3.zero
                        rootPart.AssemblyLinearVelocity = Vector3.zero
                        rootPart.AssemblyAngularVelocity = Vector3.zero
                        if fakeHumanoid and fakeHumanoid.Parent then fakeHumanoid.Health = 100 end
                    else
                        if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
                    end
                end)

                local function moverSemHumanoid(destino, velocidade)
                    local startPos = posicaoControleCFrame
                    local distance = (destino - startPos).Magnitude
                    if distance == 0 then return end
                    local duration = distance / velocidade
                    local startTime = tick()
                    while tick() - startTime < duration do
                        if not _G.ActiveSteals[ovoID] then return end
                        local elapsed = tick() - startTime
                        local progress = math.clamp(elapsed / duration, 0, 1)
                        posicaoControleCFrame = startPos:Lerp(destino, progress)
                        posicionamentoTravadoCFrame = CFrame.new(posicaoControleCFrame)
                        task.wait()
                    end
                    posicaoControleCFrame = destino
                    posicionamentoTravadoCFrame = CFrame.new(posicaoControleCFrame)
                end

                task.spawn(function()
                    while (Vector3.new(posicaoControleCFrame.X, 0, posicaoControleCFrame.Z) - Vector3.new(coordenadaFinal.X, 0, coordenadaFinal.Z)).Magnitude > 1.5 do
                        if not _G.ActiveSteals[ovoID] then break end
                        local posicaoAlto = posicaoControleCFrame + Vector3.new(0, 30, 0)
                        moverSemHumanoid(posicaoAlto, velocidadeCFrame)
                        task.wait(0.05)
                        
                        if not _G.ActiveSteals[ovoID] then break end
                        local flatCurrent = Vector3.new(posicaoControleCFrame.X, 0, posicaoControleCFrame.Z)
                        local flatTarget = Vector3.new(coordenadaFinal.X, 0, coordenadaFinal.Z)
                        local direcao = (flatTarget - flatCurrent).Unit
                        local distanciaRestante = (flatTarget - flatCurrent).Magnitude
                        
                        local distanciaEtapa = math.min(800, distanciaRestante)
                        local proximaPosicaoHorizontal = flatCurrent + (direcao * distanciaEtapa)
                        local pontoDestinoNoAlto = Vector3.new(proximaPosicaoHorizontal.X, posicaoControleCFrame.Y, proximaPosicaoHorizontal.Z)
                        moverSemHumanoid(pontoDestinoNoAlto, velocidadeCFrame)
                        
                        task.wait(0.20)
                        if not _G.ActiveSteals[ovoID] then break end
                        executarScriptBotao()
                        
                        local pontoDescida = Vector3.new(posicaoControleCFrame.X, coordenadaFinal.Y, posicaoControleCFrame.Z)
                        moverSemHumanoid(pontoDescida, velocidadeCFrame)
                        
                        if not _G.ActiveSteals[ovoID] then break end
                        executarSistemaPrompts()
                        task.wait(0.50)
                    end
                    
                    if _G.ActiveSteals[ovoID] then 
                        moverSemHumanoid(coordenadaFinal, velocidadeCFrame) 
                    end
                    
                    -- LIMPEZA DOS GATILHOS DE TRAVA E DO HUMANÓIDE FAKE
                    if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
                    if fakeHumanoid then fakeHumanoid:Destroy() end
                    
                    rootPart.Velocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    task.wait(0.1)
                    
                    -- RESTAURAÇÃO: Devolve o seu Humanoid original com tudo intacto!
                    humanoidOriginal.Parent = character
                    workspace.CurrentCamera.CameraSubject = humanoidOriginal
                    
                    rootPart.CFrame = CFrame.new(coordenadaFinal)
                    
                    -- Desliga o estado global por último
                    _G.ActiveSteals[ovoID] = false
                end)
            end
        else
            if conexaoCorrida then conexaoCorrida:Disconnect() end
        end
    end)
end
